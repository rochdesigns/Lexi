APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production must be https. Queued mail is built in a worker with no request to
# take a scheme from, so every signed verification and reset link is issued at
# whatever APP_URL says; an http link fails its own signature check once nginx
# redirects the click to https. ProductionConfigGuard refuses to boot on it.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# The first two are required to be true in production; the boot fails otherwise.
# Herd serves the site over https, so they hold locally too.
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
# Must be lax or strict -- [none] fails the boot. Use lax: strict withholds the
# cookie on a cross-site top-level navigation, which is what clicking a link in
# a mail client is, and the email verification route sits behind auth. Under
# strict that click arrives as a guest, redirects, and never verifies, with no
# error anywhere. Lax still withholds the cookie on cross-site POSTs.
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk for user uploads. Must be private; never set this to "public".
UPLOADS_DISK=local

# Database dumps. In production point BACKUP_DISK at off-server storage (s3),
# so losing the server does not lose the backups with it.
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETAIN_DAYS=30

# Queued work needs a worker consuming it. Without one the queue accepts jobs,
# answers the request with a success and delivers nothing, which is how a
# verification mail goes missing with no error anywhere. `queue:verify-draining`
# runs on the scheduler and looks for jobs nobody has claimed: QUEUE_MAX_WAIT is
# how many seconds one may sit before that counts as stalled, and
# QUEUE_ALERT_EMAIL is who hears about it. Empty, it only logs.
QUEUE_CONNECTION=database
QUEUE_MAX_WAIT=300
QUEUE_ALERT_EMAIL=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local writes mail to the log. Production sends through Resend's HTTP API,
# which the boot guard requires an API key for. The API is used rather than
# SMTP because outbound SMTP ports are commonly blocked by hosting providers,
# while 443 is not:
#
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_your_api_key
#   MAIL_FROM_ADDRESS="no-reply@your-verified-domain"
#
# SMTP remains configured below as a fallback (smtp.resend.com, username the
# literal string "resend", password the API key, port 587 or 2587).
#
# Resend will not deliver until the domain's DKIM and SPF records are in DNS;
# it shows the exact records, and unauthenticated mail is spam-foldered.
#
# Verification and reset mail is queued, so production needs a running queue
# worker or it is accepted and never delivered.
RESEND_API_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Seconds before a stalled SMTP connection gives up. Without it PHP waits 60,
# which outlives the web server and surfaces as a 504 with nothing logged.
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Passport signing keys for the MCP server: PEM contents (generate with `php artisan passport:keys`). Must be set, or key files must exist in storage, before deploying to production.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
