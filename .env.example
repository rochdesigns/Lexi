APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# All three are required to be these values in production; the boot fails
# otherwise. Herd serves the site over https, so they hold locally too.
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk for user uploads. Must be private; never set this to "public".
UPLOADS_DISK=local

# Database dumps. In production point BACKUP_DISK at off-server storage (s3),
# so losing the server does not lose the backups with it.
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETAIN_DAYS=30
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local writes mail to the log. Production sends through Resend's HTTP API,
# which the boot guard requires an API key for. The API is used rather than
# SMTP because outbound SMTP ports are commonly blocked by hosting providers,
# while 443 is not:
#
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_your_api_key
#   MAIL_FROM_ADDRESS="no-reply@your-verified-domain"
#
# SMTP remains configured below as a fallback (smtp.resend.com, username the
# literal string "resend", password the API key, port 587 or 2587).
#
# Resend will not deliver until the domain's DKIM and SPF records are in DNS;
# it shows the exact records, and unauthenticated mail is spam-foldered.
RESEND_API_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Seconds before a stalled SMTP connection gives up. Without it PHP waits 60,
# which outlives the web server and surfaces as a 504 with nothing logged.
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
